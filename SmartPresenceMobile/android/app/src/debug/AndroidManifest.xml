<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
      En debug seulement, le trafic en clair est permis vers n'importe quel hote.
      Cela evite d'avoir a inscrire l'adresse du poste de developpement dans
      res/xml/network_security_config.xml chaque fois que l'on essaie
      l'application sur un telephone reel branche au meme reseau.

      Ce fichier n'est pas fusionne dans une compilation release : celle-ci reste
      soumise a la liste d'hotes de network_security_config.xml. L'attribut est
      pose ici et non dans ce fichier-la parce que cleartextTrafficPermitted n'y
      vaut que pour base-config et domain-config, jamais pour debug-overrides.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
